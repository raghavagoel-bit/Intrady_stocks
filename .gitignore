# ============================================================================
# Vibe-Intraday — .gitignore
#
# Purpose of this repo: a restore point for the live paper bake-off (BUG-004
# has scratched two trading days; the roster + strategy source existed in
# exactly one place before this).
#
# Rule of thumb:
#   COMMIT   source — strategy run-dirs (code/ + config.json), agent code,
#            configs, docs, tests. Losing these is what the repo exists to
#            prevent.
#   IGNORE   secrets, market data, and run outcomes — anything regenerated by
#            running the system, plus anything that must never leave the host.
# ============================================================================

# --- Secrets — never commit -------------------------------------------------
.env
*.env
!*.env.example
dhan.json
**/dhan.json
*access_token*
*.pem
*.key

# --- Market data caches -----------------------------------------------------
strategies/.bt_cache/
**/.bt_cache/
*.parquet

# --- Run outcomes: backtest + evaluation outputs ----------------------------
# Generated by strategies/backtest_all.py and evaluate_strategies.py.
# The human-readable .md reports in docs/ ARE committed (workflow docs);
# only the raw result data is ignored.
docs/backtest_results*.json
docs/backtest_daily_pnl*.csv
strategies/backtest_results*.json
strategies/backtest_daily_pnl*.csv

# COMMITTED on purpose (do not add to the ignores above): these are decision
# evidence for LIVE config, not regenerable output. The Yahoo 15m window rolls
# weekly, so neither can ever be reproduced:
#   docs/backtest_tuning_20260715.json — evidence for the 7 tuned defaults
#                                        applied to live strategies (3I.2)
#   docs/universe_scan.json            — the 3J scan that chose the 38-stock
#                                        universe in config/intraday.json

# --- Run outcomes: live session state ---------------------------------------
logs/
**/logs/
*.log
scoreboard.json
scoreboard*.bak-*
llm_journal-*.jsonl
audit*.jsonl

# Runtime root (~/.vibe-trading/) lives outside this tree, but guard against a
# stray local copy or a future runtime_root pointed inside the repo.
.vibe-trading/
**/.vibe-trading/

# --- Backups ----------------------------------------------------------------
*.bak
*.bak-*
*.orig

# --- Scratch / working files ------------------------------------------------
scratchpad/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# --- Node (frontend) --------------------------------------------------------
node_modules/
dist/
.vite/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
